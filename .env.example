# Copier ce fichier en .env et le compléter. Ne jamais committer .env.

# Token du bot : Discord Developer Portal > ton application > Bot > Reset Token
DISCORD_TOKEN=

# ID du serveur de test : les commandes y sont synchronisées instantanément.
# Laisser vide en production (synchronisation globale, jusqu'à 1 h de délai).
DEV_GUILD_ID=

# Salon unique autorisé pour toutes les commandes du bot (facultatif).
# Laisser vide pour autoriser tous les salons. Clic droit sur le salon > Copier l'identifiant.
BOT_CHANNEL_ID=

# Commandes /dev : faux joueurs pour tester seul (voir README). Jamais en production.
ENABLE_DEV_COMMANDS=false

# Identifiants Discord autorisés à utiliser les commandes /admin, séparés par des virgules.
# Vide = uniquement les membres avec la permission « Gérer le serveur ».
ADMIN_USER_IDS=

# Base de données. Postgres : postgresql+asyncpg://user:motdepasse@hote/base (ajouter asyncpg)
DATABASE_URL=sqlite+aiosqlite:///data/riftbot.db

# Garde-fou anti-boucle de redémarrage : le bot refuse de contacter Discord
# après STARTUP_MAX_ATTEMPTS démarrages en STARTUP_WINDOW_SECONDS secondes.
# Mettre 0 à STARTUP_MAX_ATTEMPTS pour désactiver (déconseillé).
STARTUP_MAX_ATTEMPTS=5
STARTUP_WINDOW_SECONDS=600

# Blocage Cloudflare (HTTP 429 sans en-tête Via) : pendant cette pause, un
# redémarrage du serveur sort immédiatement sans contacter Discord, pour ne pas
# aggraver le blocage d'IP. 0 désactive la pause (déconseillé).
LOGIN_COOLDOWN_SECONDS=1800
# Nouvelles tentatives de connexion dans le même processus sur une erreur
# transitoire (HTTP 5xx). 1 désactive les nouvelles tentatives.
LOGIN_MAX_ATTEMPTS=3
LOGIN_RETRY_DELAY_SECONDS=10
LOGIN_MAX_RETRY_DELAY_SECONDS=120

# Forcer la synchronisation des slash commands au démarrage, même si elles
# n'ont pas changé (utile après une suppression manuelle dans Discord).
FORCE_COMMAND_SYNC=false

# Règles
BEST_OF=3
AUTO_CONFIRM_HOURS=24

# Ladder noté
# Matchs de placement avant d'entrer dans le classement principal.
PLACEMENT_MATCHES=2
# Éviter les revanches : préférence sur 4 semaines, contrainte sur 2 semaines.
REMATCH_PREFERRED_WEEKS=4
REMATCH_HARD_WEEKS=2
# Semaines sans match avant le badge « inactif ».
INACTIVE_AFTER_WEEKS=3

# Économie : hors V1, laisser false. Le code des paris reste disponible pour plus tard.
ENABLE_BETTING=false
STARTING_BALANCE=1000

LOG_LEVEL=INFO
